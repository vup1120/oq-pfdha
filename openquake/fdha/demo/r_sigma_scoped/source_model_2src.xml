<?xml version="1.0" encoding="utf-8"?>
<nrml
xmlns="http://openquake.org/xmlns/nrml/0.5"
xmlns:gml="http://www.opengis.net/gml"
>
    <!-- Demo-only source model: TWO parallel M7.0 characteristic faults.
         Fault A is the trace of demo/r_sigma_epistemic/source_model_M7.xml;
         fault B is the same trace shifted 0.008 deg east (~0.69 km), far
         enough that each fault's near-field (boxcar 50 m, Gaussian 2*sigma
         <= 145 m) never reaches the other fault's site. Each fault ruptures
         as a single M7.0 characteristic event at 1e-4/yr. All values are
         illustrative demo inputs, not recommendations. -->
    <sourceModel
    name="Demo two parallel M7.0 characteristic faults"
    >
        <sourceGroup
        name="group 1"
        tectonicRegion="Active Shallow Crust"
        >
            <characteristicFaultSource
            id="src_A"
            name="Fault A (sigma-scoped in the demo tree)"
            tectonicRegion="Active Shallow Crust"
            >
                <incrementalMFD minMag="7.0000000E+00" binWidth="1.0000000E-01">
                    <occurRates>1.0000000E-04</occurRates>
                </incrementalMFD>
                <rake>
                    -9.0000000E+01
                </rake>
                <surface>
                    <simpleFaultGeometry>
                        <gml:LineString>
                    <gml:posList>
                        16.1870362931   39.6974567774
                        16.1505303713   39.6274955882
                        16.1455213236   39.6196231258
                        16.1408996159   39.5840858442
                    </gml:posList>
                        </gml:LineString>
                        <dip>
                            3.0000000E+01
                        </dip>
                        <upperSeismoDepth>
                            0.0000000E+00
                        </upperSeismoDepth>
                        <lowerSeismoDepth>
                            1.5000000E+01
                        </lowerSeismoDepth>
                    </simpleFaultGeometry>
                </surface>
            </characteristicFaultSource>
            <characteristicFaultSource
            id="src_B"
            name="Fault B (stays on the boxcar in the demo tree)"
            tectonicRegion="Active Shallow Crust"
            >
                <incrementalMFD minMag="7.0000000E+00" binWidth="1.0000000E-01">
                    <occurRates>1.0000000E-04</occurRates>
                </incrementalMFD>
                <rake>
                    -9.0000000E+01
                </rake>
                <surface>
                    <simpleFaultGeometry>
                        <gml:LineString>
                    <gml:posList>
                        16.1950362931   39.6974567774
                        16.1585303713   39.6274955882
                        16.1535213236   39.6196231258
                        16.1488996159   39.5840858442
                    </gml:posList>
                        </gml:LineString>
                        <dip>
                            3.0000000E+01
                        </dip>
                        <upperSeismoDepth>
                            0.0000000E+00
                        </upperSeismoDepth>
                        <lowerSeismoDepth>
                            1.5000000E+01
                        </lowerSeismoDepth>
                    </simpleFaultGeometry>
                </surface>
            </characteristicFaultSource>
        </sourceGroup>
    </sourceModel>
</nrml>
