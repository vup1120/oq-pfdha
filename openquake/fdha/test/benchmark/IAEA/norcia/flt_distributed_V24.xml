<?xml version="1.0" encoding="UTF-8"?>
<nrml xmlns="http://openquake.org/xmlns/nrml/0.4">
  <logicTree logicTreeID="lt_fdha_norcia_distributed_V24">
    <logicTreeBranchingLevel branchingLevelID="bl_1_primary_surf_rup">
      <logicTreeBranchSet branchSetID="bs_1" uncertaintyType="fdhaPrimarySRModel">
        <logicTreeBranch branchID="B1_PSR">
          <uncertaintyModel>
            [FixedPrimarySR]
            value = 1.0
          </uncertaintyModel>
          <uncertaintyWeight>1.0</uncertaintyWeight>
        </logicTreeBranch>
      </logicTreeBranchSet>
    </logicTreeBranchingLevel>
    <logicTreeBranchingLevel branchingLevelID="bl_2_primary_surf_displ">
      <logicTreeBranchSet branchSetID="bs_2" uncertaintyType="fdhaPrimaryFDModel" applyToBranches="B1_PSR">
        <logicTreeBranch branchID="B2_PFD">
          <uncertaintyModel>
            [Takao2013PrimaryFD]
            norm_disp_type = AD
            n_sigma = 5.0
          </uncertaintyModel>
          <uncertaintyWeight>1.0</uncertaintyWeight>
        </logicTreeBranch>
      </logicTreeBranchSet>
    </logicTreeBranchingLevel>
    <logicTreeBranchingLevel branchingLevelID="bl_3_secondary_surf_rup">
      <logicTreeBranchSet branchSetID="bs_3" uncertaintyType="fdhaSecondarySRModel" applyToBranches="B2_PFD">
        <logicTreeBranch branchID="B3_SSR">
          <uncertaintyModel>
            [Visini2025SecondarySR]
            pixel_size = 100
          </uncertaintyModel>
          <uncertaintyWeight>1.0</uncertaintyWeight>
        </logicTreeBranch>
      </logicTreeBranchSet>
    </logicTreeBranchingLevel>
    <logicTreeBranchingLevel branchingLevelID="bl_4_secondary_surf_displ">
      <logicTreeBranchSet branchSetID="bs_4" uncertaintyType="fdhaSecondaryFDModel" applyToBranches="B3_SSR">
        <logicTreeBranch branchID="B4_SFD">
          <uncertaintyModel>
            [Visini2025SecondaryFD]
            scaling_model = WC1994
          </uncertaintyModel>
          <uncertaintyWeight>1.0</uncertaintyWeight>
        </logicTreeBranch>
      </logicTreeBranchSet>
    </logicTreeBranchingLevel>
  </logicTree>
</nrml>
