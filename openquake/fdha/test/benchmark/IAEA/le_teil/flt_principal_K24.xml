<?xml version="1.0" encoding="UTF-8"?>
<nrml xmlns="http://openquake.org/xmlns/nrml/0.4">
  <logicTree logicTreeID="lt_fdha_le_teil_principal_K24">
  <logicTreeBranchSet branchSetID="bs_1" uncertaintyType="fdhaPrimarySRModel">
    <logicTreeBranch branchID="B1_PSR">
      <uncertaintyModel>
        [FixedPrimarySR]
        value = 1.0
      </uncertaintyModel>
      <uncertaintyWeight>1.0</uncertaintyWeight>
    </logicTreeBranch>
  </logicTreeBranchSet>
  <logicTreeBranchSet branchSetID="bs_2" uncertaintyType="fdhaPrimaryFDModel" applyToBranches="B1_PSR">
    <logicTreeBranch branchID="B2_PFD">
      <uncertaintyModel>
        [Kuehn2024PrimaryFD]
      </uncertaintyModel>
      <uncertaintyWeight>1.0</uncertaintyWeight>
    </logicTreeBranch>
  </logicTreeBranchSet>
    <!-- Kuehn2024PrimaryFD predicts AGGREGATE displacement (Sarmiento et al.
         2025 Table 1): the distributed contribution is already inside the
         prediction, so the chain runs as a single bucket and the secondary
         slots must stay empty (FDLT-013). The former no-op secondary levels
         (FixedSecondarySR value = 0.0 + Youngs2003SecondaryFD) were removed
         2026-07-17; results are numerically identical (secondary SR was 0). -->
  </logicTree>
</nrml>
