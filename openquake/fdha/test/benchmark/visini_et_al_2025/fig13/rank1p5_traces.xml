        <gml:posList>16.2075 39.64648968 16.2475 39.64648968</gml:posList>
      </gml:LineString>
    </trace>

    <!-- Case 2: fault near the site. The paper text says 200 m, but the
         published Figure 13 curves (and the FDHLab script
