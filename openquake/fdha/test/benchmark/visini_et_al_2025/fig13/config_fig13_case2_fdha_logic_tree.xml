<?xml version="1.0" encoding="UTF-8"?>
<nrml xmlns="http://openquake.org/xmlns/nrml/0.4">
  <logicTree logicTreeID="lt_fdha_config_fig13_case2">
  <logicTreeBranchSet branchSetID="bs_1_primary_surf_rup" uncertaintyType="fdhaPrimarySRModel">
    <logicTreeBranch branchID="B1_PRIMARY_SURF_RUP">
      <uncertaintyModel>
        [FixedPrimarySR]
        value = 1.0
      </uncertaintyModel>
      <uncertaintyWeight>1.0</uncertaintyWeight>
    </logicTreeBranch>
  </logicTreeBranchSet>
  <logicTreeBranchSet branchSetID="bs_2_primary_surf_displ" uncertaintyType="fdhaPrimaryFDModel" applyToBranches="B1_PRIMARY_SURF_RUP">
    <logicTreeBranch branchID="B2_PRIMARY_SURF_DISPL">
      <uncertaintyModel>
        [Moss2024PrimaryFD]
        version = "MD"
        source = "EQS"
        completeness = "all"
      </uncertaintyModel>
      <uncertaintyWeight>1.0</uncertaintyWeight>
    </logicTreeBranch>
  </logicTreeBranchSet>
  <logicTreeBranchSet branchSetID="bs_3_secondary_surf_rup" uncertaintyType="fdhaSecondarySRModel" applyToBranches="B2_PRIMARY_SURF_DISPL">
    <logicTreeBranch branchID="B3_SECONDARY_SURF_RUP">
      <uncertaintyModel>
        [Visini2025SecondarySR]
        style = "normal"
        pixel_size = 100
        rupture_traces = "["R1p5_200m"]"
      </uncertaintyModel>
      <uncertaintyWeight>1.0</uncertaintyWeight>
    </logicTreeBranch>
  </logicTreeBranchSet>
  <logicTreeBranchSet branchSetID="bs_4_secondary_surf_displ" uncertaintyType="fdhaSecondaryFDModel" applyToBranches="B3_SECONDARY_SURF_RUP">
    <logicTreeBranch branchID="B4_SECONDARY_SURF_DISPL">
      <uncertaintyModel>
        [Visini2025SecondaryFD]
        style = "normal"
        tpfm = 1.42
        n_sigma = 3
        rupture_traces = "["R1p5_200m"]"
      </uncertaintyModel>
      <uncertaintyWeight>1.0</uncertaintyWeight>
    </logicTreeBranch>
  </logicTreeBranchSet>
  </logicTree>
</nrml>
