<?xml version="1.0" encoding="UTF-8"?>
<nrml xmlns="http://openquake.org/xmlns/nrml/0.4">
  <logicTree logicTreeID="lt_fdha_config_visini">
    <logicTreeBranchingLevel branchingLevelID="bl_1_primary_surf_rup">
      <logicTreeBranchSet branchSetID="bs_1_primary_surf_rup" uncertaintyType="fdhaPrimarySRModel">
        <logicTreeBranch branchID="B1_PRIMARY_SURF_RUP">
          <uncertaintyModel>
            [Moss2013PrimarySR]
            style = reverse
            vs30 = 600
          </uncertaintyModel>
          <uncertaintyWeight>1.0</uncertaintyWeight>
        </logicTreeBranch>
      </logicTreeBranchSet>
    </logicTreeBranchingLevel>
    <logicTreeBranchingLevel branchingLevelID="bl_2_primary_surf_displ">
      <logicTreeBranchSet branchSetID="bs_2_primary_surf_displ" uncertaintyType="fdhaPrimaryFDModel" applyToBranches="B1_PRIMARY_SURF_RUP">
        <logicTreeBranch branchID="B2_PRIMARY_SURF_DISPL">
          <uncertaintyModel>
            [Moss2024PrimaryFD]
            version = MD
            source = EQS
            completeness = all
          </uncertaintyModel>
          <uncertaintyWeight>1.0</uncertaintyWeight>
        </logicTreeBranch>
      </logicTreeBranchSet>
    </logicTreeBranchingLevel>
    <logicTreeBranchingLevel branchingLevelID="bl_3_secondary_surf_rup">
      <logicTreeBranchSet branchSetID="bs_3_secondary_surf_rup" uncertaintyType="fdhaSecondarySRModel" applyToBranches="B2_PRIMARY_SURF_DISPL">
        <logicTreeBranch branchID="B3_SECONDARY_SURF_RUP">
          <uncertaintyModel>
            [Visini2025SecondarySR]
            style = reverse
            pixel_size = 50
            rupture_traces = ["Sibari_splay_A", "Sibari_splay_B"]
          </uncertaintyModel>
          <uncertaintyWeight>1.0</uncertaintyWeight>
        </logicTreeBranch>
      </logicTreeBranchSet>
    </logicTreeBranchingLevel>
    <logicTreeBranchingLevel branchingLevelID="bl_4_secondary_surf_displ">
      <logicTreeBranchSet branchSetID="bs_4_secondary_surf_displ" uncertaintyType="fdhaSecondaryFDModel" applyToBranches="B3_SECONDARY_SURF_RUP">
        <logicTreeBranch branchID="B4_SECONDARY_SURF_DISPL">
          <uncertaintyModel>
            [Visini2025SecondaryFD]
            style = reverse
            scaling_model = LEONARD2010
            rupture_traces = ["Sibari_splay_A", "Sibari_splay_B"]
          </uncertaintyModel>
          <uncertaintyWeight>1.0</uncertaintyWeight>
        </logicTreeBranch>
      </logicTreeBranchSet>
    </logicTreeBranchingLevel>
  </logicTree>
</nrml>
