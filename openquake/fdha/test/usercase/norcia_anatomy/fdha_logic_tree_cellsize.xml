<?xml version="1.0" encoding="UTF-8"?>
<!--
  Cell-size sensitivity of the Visini et al. (2025) distributed chain.

  Identical to the primary levels of fdha_logic_tree_anatomy.xml, with the
  distributed level restricted to Visini et al. (2025) evaluated at two of
  its published site-cell widths:

    pixel_size = 100 m  - the IAEA-fixed 100 x 100 m site dimension used
                          in the anatomy tree
    pixel_size = 500 m  - the largest published cell (Table 2 is
                          calibrated for 10/20/50/100/200/500 m)

  pixel_size is a SITE dimension, not a model grid: it selects the
  across-strike logistic coefficients (Table 2) and sets the along-strike
  extent of the Monte Carlo intersection test, so a larger cell asks
  "is a larger site ruptured?" and necessarily returns a larger
  probability. Youngs et al. (2003) expose no equivalent parameter -
  their logistic regression carries the original study's cell convention
  implicitly - so the comparison can only be made on the Visini side.

  Running this tree reproduces the 100 m curve of the anatomy tree
  exactly (same primary weights, same displacement pairings), so the two
  cell widths are directly comparable.

  12 primary combinations x 2 cell widths x 3 displacement pairings
  = 72 end branches.
-->
<nrml xmlns="http://openquake.org/xmlns/nrml/0.4">
  <logicTree logicTreeID="lt_fdha_norcia_cellsize">

    <logicTreeBranchingLevel branchingLevelID="bl_1_primary_surf_rup">
      <logicTreeBranchSet branchSetID="bs_1_primary_surf_rup"
                          uncertaintyType="fdhaPrimarySRModel">
        <logicTreeBranch branchID="PSR_PIZZA23_YDEF">
          <uncertaintyModel>
            [Pizza2023PrimarySR]
            style = normal
          </uncertaintyModel>
          <uncertaintyWeight>0.2</uncertaintyWeight>
        </logicTreeBranch>
        <logicTreeBranch branchID="PSR_PIZZA23_LAV">
          <uncertaintyModel>
            [Pizza2023PrimarySR]
            style = normal
          </uncertaintyModel>
          <uncertaintyWeight>0.2</uncertaintyWeight>
        </logicTreeBranch>
        <logicTreeBranch branchID="PSR_Y03EC_YDEF">
          <uncertaintyModel>
            [Youngs2003PrimarySR]
            version = ExtensionalCordillera
          </uncertaintyModel>
          <uncertaintyWeight>0.1</uncertaintyWeight>
        </logicTreeBranch>
        <logicTreeBranch branchID="PSR_Y03EC_LAV">
          <uncertaintyModel>
            [Youngs2003PrimarySR]
            version = ExtensionalCordillera
          </uncertaintyModel>
          <uncertaintyWeight>0.1</uncertaintyWeight>
        </logicTreeBranch>
        <logicTreeBranch branchID="PSR_Y03NBR_YDEF">
          <uncertaintyModel>
            [Youngs2003PrimarySR]
            version = NorthernBasinAndRange
          </uncertaintyModel>
          <uncertaintyWeight>0.1</uncertaintyWeight>
        </logicTreeBranch>
        <logicTreeBranch branchID="PSR_Y03NBR_LAV">
          <uncertaintyModel>
            [Youngs2003PrimarySR]
            version = NorthernBasinAndRange
          </uncertaintyModel>
          <uncertaintyWeight>0.1</uncertaintyWeight>
        </logicTreeBranch>
        <logicTreeBranch branchID="PSR_Y03GB_YDEF">
          <uncertaintyModel>
            [Youngs2003PrimarySR]
            version = GreatBasin
          </uncertaintyModel>
          <uncertaintyWeight>0.1</uncertaintyWeight>
        </logicTreeBranch>
        <logicTreeBranch branchID="PSR_Y03GB_LAV">
          <uncertaintyModel>
            [Youngs2003PrimarySR]
            version = GreatBasin
          </uncertaintyModel>
          <uncertaintyWeight>0.1</uncertaintyWeight>
        </logicTreeBranch>
      </logicTreeBranchSet>
    </logicTreeBranchingLevel>

    <logicTreeBranchingLevel branchingLevelID="bl_2_primary_surf_displ">
      <logicTreeBranchSet branchSetID="bs_2_primary_surf_displ_ydef"
                          uncertaintyType="fdhaPrimaryFDModel"
                          applyToBranches="PSR_PIZZA23_YDEF PSR_Y03EC_YDEF PSR_Y03NBR_YDEF PSR_Y03GB_YDEF">
        <logicTreeBranch branchID="PFD_Y03_AD">
          <uncertaintyModel>
            [Youngs2003PrimaryFD]
            norm_disp_type = AD
          </uncertaintyModel>
          <uncertaintyWeight>0.5</uncertaintyWeight>
        </logicTreeBranch>
        <logicTreeBranch branchID="PFD_Y03_MD">
          <uncertaintyModel>
            [Youngs2003PrimaryFD]
            norm_disp_type = MD
          </uncertaintyModel>
          <uncertaintyWeight>0.5</uncertaintyWeight>
        </logicTreeBranch>
      </logicTreeBranchSet>
      <logicTreeBranchSet branchSetID="bs_2_primary_surf_displ_lav"
                          uncertaintyType="fdhaPrimaryFDModel"
                          applyToBranches="PSR_PIZZA23_LAV PSR_Y03EC_LAV PSR_Y03NBR_LAV PSR_Y03GB_LAV">
        <logicTreeBranch branchID="PFD_LAV23">
          <uncertaintyModel>
            [Lavrentiadis2023PrimaryFD_principal]
            style = normal
          </uncertaintyModel>
          <uncertaintyWeight>1.0</uncertaintyWeight>
        </logicTreeBranch>
      </logicTreeBranchSet>
    </logicTreeBranchingLevel>

    <logicTreeBranchingLevel branchingLevelID="bl_3_secondary_surf_rup">
      <logicTreeBranchSet branchSetID="bs_3_secondary_surf_rup"
                          uncertaintyType="fdhaSecondarySRModel">
        <logicTreeBranch branchID="SSR_V25_C100">
          <uncertaintyModel>
            [Visini2025SecondarySR]
            style = normal
            pixel_size = 100
          </uncertaintyModel>
          <uncertaintyWeight>0.5</uncertaintyWeight>
        </logicTreeBranch>
        <logicTreeBranch branchID="SSR_V25_C500">
          <uncertaintyModel>
            [Visini2025SecondarySR]
            style = normal
            pixel_size = 500
          </uncertaintyModel>
          <uncertaintyWeight>0.5</uncertaintyWeight>
        </logicTreeBranch>
      </logicTreeBranchSet>
    </logicTreeBranchingLevel>

    <logicTreeBranchingLevel branchingLevelID="bl_4_secondary_surf_displ">
      <logicTreeBranchSet branchSetID="bs_4_secondary_surf_displ_v25"
                          uncertaintyType="fdhaSecondaryFDModel">
        <logicTreeBranch branchID="SFD_V25_WC94">
          <uncertaintyModel>
            [Visini2025SecondaryFD]
            scaling_model = WC1994
          </uncertaintyModel>
          <uncertaintyWeight>0.33</uncertaintyWeight>
        </logicTreeBranch>
        <logicTreeBranch branchID="SFD_V25_TB17">
          <uncertaintyModel>
            [Visini2025SecondaryFD]
            scaling_model = THINGBAIJAM2017
          </uncertaintyModel>
          <uncertaintyWeight>0.33</uncertaintyWeight>
        </logicTreeBranch>
        <logicTreeBranch branchID="SFD_V25_LEO10">
          <uncertaintyModel>
            [Visini2025SecondaryFD]
            scaling_model = LEONARD2010
          </uncertaintyModel>
          <uncertaintyWeight>0.34</uncertaintyWeight>
        </logicTreeBranch>
      </logicTreeBranchSet>
    </logicTreeBranchingLevel>

    <logicTreeBranchingLevel branchingLevelID="bl_5_r_sigma">
      <logicTreeBranchSet branchSetID="bs_5_r_sigma"
                          uncertaintyType="fdhaCalcRSigma">
        <logicTreeBranch branchID="RS_ACCURATE">
          <uncertaintyModel>0.02689</uncertaintyModel>
          <uncertaintyWeight>1.0</uncertaintyWeight>
        </logicTreeBranch>
      </logicTreeBranchSet>
    </logicTreeBranchingLevel>

  </logicTree>
</nrml>
