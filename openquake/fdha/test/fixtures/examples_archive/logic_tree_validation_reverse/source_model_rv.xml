<?xml version="1.0" encoding="utf-8"?>
<!--
    Logic Tree Validation (reverse) demo - shared source model.

    Single reverse (rake=90 deg, dip=45 deg) characteristic fault used by all
    three runs (single_youngs2003, single_moss2024, blend_50_50) in this
    folder.

    Trace geometry is identical to the strike-slip sibling
    (examples/logic_tree_validation/source_model_ss.xml); only the dip and
    rake are changed so the source is classified as 'reverse' under the
    rake-to-style mapping (openquake.fdha.calc.contexts.classify_style,
    rake in [30, 150] -> reverse). See Aki & Richards 1980 §4.2.

    File name includes the "_rv" suffix to avoid path-resolution collisions
    with the existing `examples/source_model.xml` (which is a rake=-90
    normal-faulting file used by unrelated examples and would otherwise be
    picked up first by the branch source-model resolver).
-->
<nrml
xmlns="http://openquake.org/xmlns/nrml/0.5"
xmlns:gml="http://www.opengis.net/gml"
>
    <sourceModel name="Logic Tree Validation Demo - reverse source">
        <sourceGroup name="group 1" tectonicRegion="Active Shallow Crust">
            <simpleFaultSource id="7" name="Simple Fault Source (reverse)" tectonicRegion="Active Shallow Crust">
                <simpleFaultGeometry>
                    <gml:LineString>
                        <gml:posList>
                            16.1870362931   39.6974567774
                            16.1505303713   39.6274955882
                            16.1455213236   39.6196231258
                            16.1408996159   39.5840858442
                        </gml:posList>
                    </gml:LineString>
                    <dip>4.5000000E+01</dip>
                    <upperSeismoDepth>0.0000000E+00</upperSeismoDepth>
                    <lowerSeismoDepth>1.5000000E+01</lowerSeismoDepth>
                </simpleFaultGeometry>
                <magScaleRel>WC1994</magScaleRel>
                <ruptAspectRatio>2.0000000E+00</ruptAspectRatio>
                <truncGutenbergRichterMFD aValue="4.2000000E+00" bValue="9.0000000E-01" maxMag="7.5000000E+00" minMag="6.5000000E+00"/>
                <rake>9.0000000E+01</rake>
            </simpleFaultSource>
        </sourceGroup>
    </sourceModel>
</nrml>
