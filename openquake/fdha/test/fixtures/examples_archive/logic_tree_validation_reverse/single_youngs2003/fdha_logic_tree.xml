<?xml version="1.0" encoding="UTF-8"?>
<!--
    Logic Tree Validation (reverse) demo - single_youngs2003.

    One Primary-SR branch (Pizza2023PrimarySR, style="all", weight=1.0)
    and one Primary-FD branch (Youngs2003PrimaryFD with style="all",
    norm_disp_type=AD, scaling_model=WC1994; weight=1.0).

    Youngs 2003 was derived for normal faulting and the implementation only
    exposes style={"all","normal"}. Applying it to a reverse-rake source
    therefore uses the style-agnostic aggregate variant (style="all"); this
    is a documented engineering convention, see README for the caveat.
-->
<nrml xmlns="http://openquake.org/xmlns/nrml/0.4">
  <logicTree logicTreeID="pfdha_validation_rv_single_youngs2003">

  <logicTreeBranchSet branchSetID="bs1_rv_psr"
                      uncertaintyType="fdhaPrimarySRModel"
                      applyToStyle="reverse">
    <logicTreeBranch branchID="RV_PSR_PIZZA2023">
      <uncertaintyModel>
        [Pizza2023PrimarySR]
        style = "all"
      </uncertaintyModel>
      <uncertaintyWeight>1.0</uncertaintyWeight>
    </logicTreeBranch>
  </logicTreeBranchSet>

  <logicTreeBranchSet branchSetID="bs2_rv_pfd"
                      uncertaintyType="fdhaPrimaryFDModel"
                      applyToBranches="RV_PSR_PIZZA2023"
                      applyToStyle="reverse">
    <logicTreeBranch branchID="RV_PFD_YOUNGS2003">
      <uncertaintyModel>
        [Youngs2003PrimaryFD]
        style = "all"
        norm_disp_type = "AD"
        scaling_model = "WC1994"
      </uncertaintyModel>
      <uncertaintyWeight>1.0</uncertaintyWeight>
    </logicTreeBranch>
  </logicTreeBranchSet>

  </logicTree>
</nrml>
