<?xml version="1.0" encoding="UTF-8"?>
<!--
    Example source-model logic tree for PFDHA.

    Structure (OpenQuake-compatible, parsed by
    openquake.hazardlib.logictree.SourceModelLogicTree):

      sourceModel       weight   uncertainty (applied on top)
      ============      ======   ==============================
      sm_a (4.2)         0.40    bGRRelative {0.0 -> 0.5,  +0.2 -> 0.5}
      sm_b (4.5)         0.60    bGRRelative {0.0 -> 0.5,  +0.2 -> 0.5}

    The cartesian product gives 4 source-model realisations whose weights
    sum to 1.0:

      sm_a x bg0 -> 0.40 x 0.5 = 0.20
      sm_a x bg1 -> 0.40 x 0.5 = 0.20
      sm_b x bg0 -> 0.60 x 0.5 = 0.30
      sm_b x bg1 -> 0.60 x 0.5 = 0.30

    The driver multiplies these by every FDHA-LT branch weight to form
    the full PFDHA realisation set (combined_weight = sm_w * fdha_w).
    The same XML is used by both the hazard-curve INI (fdha_curve.ini)
    and the hazard-map INI (fdha_map.ini).
-->
<nrml xmlns="http://openquake.org/xmlns/nrml/0.4">
  <logicTree logicTreeID="example_smlt">

    <!-- Outer branch set: alternative full source-model XML files. -->
    <logicTreeBranchSet branchSetID="bs_sourceModel"
                        uncertaintyType="sourceModel">
      <logicTreeBranch branchID="sm_a">
        <uncertaintyModel>source_model_a.xml</uncertaintyModel>
        <uncertaintyWeight>0.4</uncertaintyWeight>
      </logicTreeBranch>
      <logicTreeBranch branchID="sm_b">
        <uncertaintyModel>source_model_b.xml</uncertaintyModel>
        <uncertaintyWeight>0.6</uncertaintyWeight>
      </logicTreeBranch>
    </logicTreeBranchSet>

    <!-- Inner branch set: NRML uncertainty modifying b-value on source 3.
         OpenQuake requires applyToBranches when the source id exists in
         more than one sourceModel branch (here source 3 is present in
         both sm_a and sm_b), so we list both branches explicitly. -->
    <logicTreeBranchSet branchSetID="bs_bGR"
                        uncertaintyType="bGRRelative"
                        applyToSources="3"
                        applyToBranches="sm_a sm_b">
      <logicTreeBranch branchID="bg0">
        <uncertaintyModel>0.0</uncertaintyModel>
        <uncertaintyWeight>0.5</uncertaintyWeight>
      </logicTreeBranch>
      <logicTreeBranch branchID="bg1">
        <uncertaintyModel>0.2</uncertaintyModel>
        <uncertaintyWeight>0.5</uncertaintyWeight>
      </logicTreeBranch>
    </logicTreeBranchSet>

  </logicTree>
</nrml>
