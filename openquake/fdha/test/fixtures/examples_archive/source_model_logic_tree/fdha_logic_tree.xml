<?xml version="1.0" encoding="UTF-8"?>
<!--
    Minimal FDHA model logic tree (separate from the OpenQuake source-model
    logic tree).  One branch per uncertainty type so the example focuses on
    the source-model side; the cartesian product per realisation is

        sm_branch x fdha_branch  ->  combined_weight = sm_w * 1.0

    Replace these with multi-branch FDHA selections (e.g. competing
    Petersen2011 / Pizza2023 primary FD models with non-trivial weights)
    to see the full SMLT x FDHA cartesian product.
-->
<nrml xmlns="http://openquake.org/xmlns/nrml/0.4">
  <logicTree logicTreeID="example_fdha_lt">

  <logicTreeBranchSet branchSetID="bs_psr"
                      uncertaintyType="fdhaPrimarySRModel"
                      applyToStyle="strike-slip">
    <logicTreeBranch branchID="PSR">
      <uncertaintyModel>
        [Pizza2023PrimarySR]
        style = "all"
      </uncertaintyModel>
      <uncertaintyWeight>1.0</uncertaintyWeight>
    </logicTreeBranch>
  </logicTreeBranchSet>

  <logicTreeBranchSet branchSetID="bs_pfd"
                      uncertaintyType="fdhaPrimaryFDModel"
                      applyToBranches="PSR"
                      applyToStyle="strike-slip">
    <logicTreeBranch branchID="PFD">
      <uncertaintyModel>
        [Petersen2011PrimaryFD]
        version = "bilinear"
      </uncertaintyModel>
      <uncertaintyWeight>1.0</uncertaintyWeight>
    </logicTreeBranch>
  </logicTreeBranchSet>

  </logicTree>
</nrml>
