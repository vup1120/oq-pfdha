<?xml version="1.0" encoding="utf-8"?>
<!--
    Logic Tree Validation demo - shared source model.

    Single strike-slip (rake=0) characteristic fault used by all three runs
    (single_bilinear, single_elliptical, blend_50_50) in this folder.

    Geometry reuses the simple fault line and depth/dip parameters from the
    sibling example (examples/logic_tree/CharacteristicFaultSourceCase2ClassicalPSHA
    /source_model.xml). The only scientific change is rake = 0 deg so the
    source is unambiguously strike-slip under the rake-to-style mapping
    (openquake.fdha.calc.contexts.classify_style; see Aki & Richards 1980 §4.2).
-->
<nrml
xmlns="http://openquake.org/xmlns/nrml/0.5"
xmlns:gml="http://www.opengis.net/gml"
>
    <sourceModel name="Logic Tree Validation Demo - SS source">
        <sourceGroup name="group 1" tectonicRegion="Active Shallow Crust">
            <simpleFaultSource id="3" name="Simple Fault Source (strike-slip)" tectonicRegion="Active Shallow Crust">
                <simpleFaultGeometry>
                    <gml:LineString>
                        <gml:posList>
                            16.1870362931   39.6974567774
                            16.1505303713   39.6274955882
                            16.1455213236   39.6196231258
                            16.1408996159   39.5840858442
                        </gml:posList>
                    </gml:LineString>
                    <dip>9.0000000E+01</dip>
                    <upperSeismoDepth>0.0000000E+00</upperSeismoDepth>
                    <lowerSeismoDepth>1.5000000E+01</lowerSeismoDepth>
                </simpleFaultGeometry>
                <magScaleRel>WC1994</magScaleRel>
                <ruptAspectRatio>2.0000000E+00</ruptAspectRatio>
                <truncGutenbergRichterMFD aValue="4.2000000E+00" bValue="9.0000000E-01" maxMag="7.5000000E+00" minMag="6.5000000E+00"/>
                <rake>0.0000000E+00</rake>
            </simpleFaultSource>
        </sourceGroup>
    </sourceModel>
</nrml>
