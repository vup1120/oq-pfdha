<?xml version="1.0" encoding="UTF-8"?>
<!--
    Logic Tree Validation demo - single_elliptical.

    One Primary-SR branch (Pizza2023PrimarySR, style="all", weight=1.0)
    and one Primary-FD branch (Petersen2011PrimaryFD version=elliptical, weight=1.0).
    No Secondary branches.
-->
<nrml xmlns="http://openquake.org/xmlns/nrml/0.4">
  <logicTree logicTreeID="pfdha_validation_single_elliptical">

  <logicTreeBranchSet branchSetID="bs1_ss_psr"
                      uncertaintyType="fdhaPrimarySRModel"
                      applyToStyle="strike-slip">
    <logicTreeBranch branchID="SS_PSR_PIZZA2023">
      <uncertaintyModel>
        [Pizza2023PrimarySR]
        style = "all"
      </uncertaintyModel>
      <uncertaintyWeight>1.0</uncertaintyWeight>
    </logicTreeBranch>
  </logicTreeBranchSet>

  <logicTreeBranchSet branchSetID="bs2_ss_pfd"
                      uncertaintyType="fdhaPrimaryFDModel"
                      applyToBranches="SS_PSR_PIZZA2023"
                      applyToStyle="strike-slip">
    <logicTreeBranch branchID="SS_PFD_ELLIPTICAL">
      <uncertaintyModel>
        [Petersen2011PrimaryFD]
        version = elliptical
      </uncertaintyModel>
      <uncertaintyWeight>1.0</uncertaintyWeight>
    </logicTreeBranch>
  </logicTreeBranchSet>

  </logicTree>
</nrml>
