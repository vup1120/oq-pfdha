<?xml version="1.0" encoding="UTF-8"?>
<!--
    Logic Tree Validation demo - blend_50_50.

    One Primary-SR branch (Pizza2023PrimarySR, weight=1.0) and TWO Primary-FD
    branches (Petersen2011PrimaryFD_bilinear vs _elliptical) with equal 0.5
    weights. Both Primary-FD branches share the same displacement definition
    (D_p_L per Sarmiento et al. 2025, Table 1 PEA11), so the advisory
    validator FDLT-101 does not fire.
-->
<nrml xmlns="http://openquake.org/xmlns/nrml/0.4">
  <logicTree logicTreeID="pfdha_validation_blend_50_50">

    <logicTreeBranchingLevel branchingLevelID="bl1_ss_psr">
      <logicTreeBranchSet branchSetID="bs1_ss_psr"
                          uncertaintyType="fdhaPrimarySRModel"
                          applyToStyle="strike-slip">
        <logicTreeBranch branchID="SS_PSR_PIZZA2023">
          <uncertaintyModel>
            [Pizza2023PrimarySR]
            style = "all"
          </uncertaintyModel>
          <uncertaintyWeight>1.0</uncertaintyWeight>
        </logicTreeBranch>
      </logicTreeBranchSet>
    </logicTreeBranchingLevel>

    <logicTreeBranchingLevel branchingLevelID="bl2_ss_pfd">
      <logicTreeBranchSet branchSetID="bs2_ss_pfd"
                          uncertaintyType="fdhaPrimaryFDModel"
                          applyToBranches="SS_PSR_PIZZA2023"
                          applyToStyle="strike-slip">
        <logicTreeBranch branchID="SS_PFD_BILINEAR">
          <uncertaintyModel>Petersen2011PrimaryFD_bilinear</uncertaintyModel>
          <uncertaintyWeight>0.5</uncertaintyWeight>
        </logicTreeBranch>
        <logicTreeBranch branchID="SS_PFD_ELLIPTICAL">
          <uncertaintyModel>Petersen2011PrimaryFD_elliptical</uncertaintyModel>
          <uncertaintyWeight>0.5</uncertaintyWeight>
        </logicTreeBranch>
      </logicTreeBranchSet>
    </logicTreeBranchingLevel>

  </logicTree>
</nrml>
