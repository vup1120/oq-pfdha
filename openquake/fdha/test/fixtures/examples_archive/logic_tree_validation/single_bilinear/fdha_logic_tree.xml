<?xml version="1.0" encoding="UTF-8"?>
<!--
    Logic Tree Validation demo - single_bilinear.

    One Primary-SR branch (Pizza2023PrimarySR, style="all", weight=1.0)
    and one Primary-FD branch (Petersen2011PrimaryFD version=bilinear, weight=1.0).
    No Secondary branches (principal-only demo, r=0 on the trace).
-->
<nrml xmlns="http://openquake.org/xmlns/nrml/0.4">
  <logicTree logicTreeID="pfdha_validation_single_bilinear">

  <logicTreeBranchSet branchSetID="bs1_ss_psr"
                      uncertaintyType="fdhaPrimarySRModel"
                      applyToStyle="strike-slip">
    <logicTreeBranch branchID="SS_PSR_PIZZA2023">
      <uncertaintyModel>
        [Pizza2023PrimarySR]
        style = "all"
      </uncertaintyModel>
      <uncertaintyWeight>1.0</uncertaintyWeight>
    </logicTreeBranch>
  </logicTreeBranchSet>

  <logicTreeBranchSet branchSetID="bs2_ss_pfd"
                      uncertaintyType="fdhaPrimaryFDModel"
                      applyToBranches="SS_PSR_PIZZA2023"
                      applyToStyle="strike-slip">
    <logicTreeBranch branchID="SS_PFD_BILINEAR">
      <uncertaintyModel>
        [Petersen2011PrimaryFD]
        version = bilinear
      </uncertaintyModel>
      <uncertaintyWeight>1.0</uncertaintyWeight>
    </logicTreeBranch>
  </logicTreeBranchSet>

  </logicTree>
</nrml>
