<?xml version="1.0" encoding="UTF-8"?>
<nrml xmlns="http://openquake.org/xmlns/nrml/0.4">
  <logicTree logicTreeID="lt_fdha">

    <!-- ============ Strike-Slip branches ============ -->
    <logicTreeBranchingLevel branchingLevelID="bl1_ss_psr">
      <logicTreeBranchSet branchSetID="bs1_ss_psr"
                          uncertaintyType="fdhaPrimarySRModel"
                          applyToStyle="strike-slip">
        <logicTreeBranch branchID="SS_PSR_MAMMA2024">
          <uncertaintyModel>[MammarellaEtAl2024PrimarySR]

          MSR = 1
          HDD_str = "AGG_R"
          dip_sigma = 10.0
          t_d = 2.0
          Zs_sigma = 2.0
          t_z = 2.0
          </uncertaintyModel>

          <uncertaintyWeight>0.5</uncertaintyWeight>
        </logicTreeBranch>
        <logicTreeBranch branchID="SS_PSR_PIZZA2023">
          <uncertaintyModel>
            [Pizza2023PrimarySR]
            style = "all"
          </uncertaintyModel>
          <uncertaintyWeight>0.5</uncertaintyWeight>
        </logicTreeBranch>
      </logicTreeBranchSet>
    </logicTreeBranchingLevel>

    <logicTreeBranchingLevel branchingLevelID="bl2_ss_pfd_given_psr">
      <logicTreeBranchSet branchSetID="bs2_ss_pfd_if_MAMMA2024"
                          uncertaintyType="fdhaPrimaryFDModel"
                          applyToBranches="SS_PSR_MAMMA2024 SS_PSR_PIZZA2023"
                          applyToStyle="strike-slip">
        <logicTreeBranch branchID="SS_PFD_CHIOU2025">
          <uncertaintyModel>Chiou2025PrimaryFD</uncertaintyModel>
          <uncertaintyWeight>0.6</uncertaintyWeight>
        </logicTreeBranch>

        <logicTreeBranch branchID="SS_PFD_PETERSEN2011_bilinear">
          <uncertaintyModel>
            [Petersen2011PrimaryFD]
            version = bilinear
          </uncertaintyModel>
          <uncertaintyWeight>0.13</uncertaintyWeight>
        </logicTreeBranch>
        <logicTreeBranch branchID="SS_PFD_PETERSEN2011_elliptical">
          <uncertaintyModel>
            [Petersen2011PrimaryFD]
            version = elliptical
          </uncertaintyModel>
          <uncertaintyWeight>0.13</uncertaintyWeight>
        </logicTreeBranch>
        <logicTreeBranch branchID="SS_PFD_PETERSEN2011_quadratic">
          <uncertaintyModel>
            [Petersen2011PrimaryFD]
            version = quadratic
          </uncertaintyModel>
          <uncertaintyWeight>0.14</uncertaintyWeight>
        </logicTreeBranch>
      </logicTreeBranchSet>

    </logicTreeBranchingLevel>

    <logicTreeBranchingLevel branchingLevelID="bl3_ss_ssr">
      <logicTreeBranchSet branchSetID="bs3_ss_ssr"
                          uncertaintyType="fdhaSecondarySRModel"
                          applyToBranches="SS_PSR_MAMMA2024 SS_PSR_PIZZA2023"
                          applyToStyle="strike-slip">
        <logicTreeBranch branchID="SS_SSR_TAKAO2014">
          <uncertaintyModel>
            [Takao2014SecondarySR]
            pixel_size = 25
          </uncertaintyModel>
          <uncertaintyWeight>0.5</uncertaintyWeight>
        </logicTreeBranch>
        <logicTreeBranch branchID="SS_SSR_PETERSEN2011">
          <uncertaintyModel>Petersen2011SecondarySR_default</uncertaintyModel>
          <uncertaintyWeight>0.5</uncertaintyWeight>
        </logicTreeBranch>
      </logicTreeBranchSet>
    </logicTreeBranchingLevel>

    <logicTreeBranchingLevel branchingLevelID="bl4_ss_sfd">
      <logicTreeBranchSet branchSetID="bs4_ss_sfd_if_TAKAO2014"
                          uncertaintyType="fdhaSecondaryFDModel"
                          applyToBranches="SS_SSR_TAKAO2014 SS_SSR_PETERSEN2011"
                          applyToStyle="strike-slip">
        <logicTreeBranch branchID="SS_SFD_PETERSEN2011">
          <uncertaintyModel>Petersen2011SecondaryFD</uncertaintyModel>
          <uncertaintyWeight>1.0</uncertaintyWeight>
        </logicTreeBranch>
      </logicTreeBranchSet>
    </logicTreeBranchingLevel>

    <!-- ============ Normal branches (placeholder weights = FDLT-007 in template) ============ -->
    <logicTreeBranchingLevel branchingLevelID="bl1_nm_psr">
      <logicTreeBranchSet branchSetID="bs1_nm_psr"
                          uncertaintyType="fdhaPrimarySRModel"
                          applyToStyle="normal">
        <logicTreeBranch branchID="NM_PSR_PIZZA2023">
          <uncertaintyModel>Pizza2023PrimarySR</uncertaintyModel>
          <uncertaintyWeight>PLACEHOLDER_WEIGHT</uncertaintyWeight>
        </logicTreeBranch>
        <logicTreeBranch branchID="NM_PSR_MAMMA2024">
          <uncertaintyModel>MammarellaEtAl2024PrimarySR</uncertaintyModel>
          <uncertaintyWeight>PLACEHOLDER_WEIGHT</uncertaintyWeight>
        </logicTreeBranch>
        <logicTreeBranch branchID="NM_PSR_YOUNGS2003">
          <uncertaintyModel>Youngs2003PrimarySR</uncertaintyModel>
          <uncertaintyWeight>PLACEHOLDER_WEIGHT</uncertaintyWeight>
        </logicTreeBranch>
      </logicTreeBranchSet>
    </logicTreeBranchingLevel>

    <logicTreeBranchingLevel branchingLevelID="bl2_nm_pfd_given_psr">
      <logicTreeBranchSet branchSetID="bs2_nm_pfd_if_psr"
                          uncertaintyType="fdhaPrimaryFDModel"
                          applyToBranches="NM_PSR_PIZZA2023 NM_PSR_MAMMA2024 NM_PSR_YOUNGS2003"
                          applyToStyle="normal">
        <logicTreeBranch branchID="NM_PFD_YOUNGS2003">
          <uncertaintyModel>Youngs2003PrimaryFD</uncertaintyModel>
          <uncertaintyWeight>PLACEHOLDER_WEIGHT</uncertaintyWeight>
        </logicTreeBranch>
        <logicTreeBranch branchID="NM_PFD_LAVRENTIADIS2023">
          <uncertaintyModel>Lavrentiadis2023PrimaryFD_aggregate</uncertaintyModel>
          <uncertaintyWeight>PLACEHOLDER_WEIGHT</uncertaintyWeight>
        </logicTreeBranch>
        <logicTreeBranch branchID="NM_PFD_KUEHN2024">
          <uncertaintyModel>Kuehn2024PrimaryFD</uncertaintyModel>
          <uncertaintyWeight>PLACEHOLDER_WEIGHT</uncertaintyWeight>
        </logicTreeBranch>
      </logicTreeBranchSet>
    </logicTreeBranchingLevel>

    <logicTreeBranchingLevel branchingLevelID="bl3_nm_ssr">
      <logicTreeBranchSet branchSetID="bs3_nm_ssr"
                          uncertaintyType="fdhaSecondarySRModel"
                          applyToBranches="NM_PSR_PIZZA2023 NM_PSR_MAMMA2024 NM_PSR_YOUNGS2003"
                          applyToStyle="normal">
        <logicTreeBranch branchID="NM_SSR_FERRARIO2021">
          <uncertaintyModel>FerrarioLivio2021SecondarySR</uncertaintyModel>
          <uncertaintyWeight>PLACEHOLDER_WEIGHT</uncertaintyWeight>
        </logicTreeBranch>
        <logicTreeBranch branchID="NM_SSR_VISINI2025">
          <uncertaintyModel>Visini2025SecondarySR</uncertaintyModel>
          <uncertaintyWeight>PLACEHOLDER_WEIGHT</uncertaintyWeight>
        </logicTreeBranch>
      </logicTreeBranchSet>
    </logicTreeBranchingLevel>

    <logicTreeBranchingLevel branchingLevelID="bl4_nm_sfd">
      <logicTreeBranchSet branchSetID="bs4_nm_sfd_if_ssr"
                          uncertaintyType="fdhaSecondaryFDModel"
                          applyToBranches="NM_SSR_FERRARIO2021 NM_SSR_VISINI2025"
                          applyToStyle="normal">
        <logicTreeBranch branchID="NM_SFD_YOUNGS2003">
          <uncertaintyModel>Youngs2003SecondaryFD</uncertaintyModel>
          <uncertaintyWeight>PLACEHOLDER_WEIGHT</uncertaintyWeight>
        </logicTreeBranch>
        <logicTreeBranch branchID="NM_SFD_VISINI2025">
          <uncertaintyModel>Visini2025SecondaryFD</uncertaintyModel>
          <uncertaintyWeight>PLACEHOLDER_WEIGHT</uncertaintyWeight>
        </logicTreeBranch>
      </logicTreeBranchSet>
    </logicTreeBranchingLevel>

  </logicTree>
</nrml>
