<?xml version="1.0" encoding="UTF-8"?>
<nrml xmlns="http://openquake.org/xmlns/nrml/0.4">
  <logicTree logicTreeID="pfdha">


    <!-- =================== BL1: PRIMARY-SR (per rake class) =================== -->
    <!-- Strike-Slip -->
  <logicTreeBranchSet branchSetID="bs1_ss_psr"
                      uncertaintyType="fdhaPrimarySRModel"
                      applyToStyle="strike-slip">
    <logicTreeBranch branchID="SS_PSR_MAMMA2024">
      <uncertaintyModel>[MammarellaEtAl2024PrimarySR]

      MSR = 1
      HDD_str = "AGG_R"
      dip_sigma = 10.0
      t_d = 2.0
      Zs_sigma = 2.0
      t_z = 2.0
      </uncertaintyModel>

      <uncertaintyWeight>0.5</uncertaintyWeight>
    </logicTreeBranch>
    <logicTreeBranch branchID="SS_PSR_PIZZA2023">
      <uncertaintyModel>
        [Pizza2023PrimarySR]
        style = "all"
      </uncertaintyModel>
      <uncertaintyWeight>0.5</uncertaintyWeight>
    </logicTreeBranch>
  </logicTreeBranchSet>

    <!-- ========== BL2: PRIMARY-FD (conditioned on PRIMARY-SR by style) ========== -->
    <!-- Strike-Slip -->
  <logicTreeBranchSet branchSetID="bs2_ss_pfd_if_MAMMA2024"
                      uncertaintyType="fdhaPrimaryFDModel"
                      applyToBranches="SS_PSR_MAMMA2024 SS_PSR_PIZZA2023"
                      applyToStyle="strike-slip">
    <logicTreeBranch branchID="SS_PFD_CHIOU2025">
      <uncertaintyModel>Chiou2025PrimaryFD</uncertaintyModel>
      <uncertaintyWeight>0.6</uncertaintyWeight>
    </logicTreeBranch>

  <!-- split Petersen2011PrimaryFD into 3 aliases  -->

    <logicTreeBranch branchID="SS_PFD_PETERSEN2011_bilinear">
      <uncertaintyModel>
        [Petersen2011PrimaryFD]
        version = bilinear
      </uncertaintyModel>
      <uncertaintyWeight>0.13</uncertaintyWeight>
    </logicTreeBranch>
    <logicTreeBranch branchID="SS_PFD_PETERSEN2011_elliptical">
      <uncertaintyModel>
        [Petersen2011PrimaryFD]
        version = elliptical
      </uncertaintyModel>
      <uncertaintyWeight>0.13</uncertaintyWeight>
    </logicTreeBranch>
    <logicTreeBranch branchID="SS_PFD_PETERSEN2011_quadratic">
      <uncertaintyModel>
        [Petersen2011PrimaryFD]
        version = quadratic
      </uncertaintyModel>
      <uncertaintyWeight>0.14</uncertaintyWeight>
    </logicTreeBranch>
  </logicTreeBranchSet>


    <!-- ======= BL3: SECONDARY-SR (conditioned on PRIMARY-SR by style) ======= -->
    <!-- Strike-Slip -->
  <logicTreeBranchSet branchSetID="bs3_ss_ssr"
                      uncertaintyType="fdhaSecondarySRModel"
                      applyToBranches="SS_PSR_MAMMA2024 SS_PSR_PIZZA2023"
                      applyToStyle="strike-slip">
    <logicTreeBranch branchID="SS_SSR_TAKAO2014">
      <uncertaintyModel>
        [Takao2014SecondarySR]
        pixel_size = 25
      </uncertaintyModel>
      <uncertaintyWeight>0.5</uncertaintyWeight>
    </logicTreeBranch>
    <logicTreeBranch branchID="SS_SSR_PETERSEN2011">
      <uncertaintyModel>Petersen2011SecondarySR_default</uncertaintyModel>
      <uncertaintyWeight>0.5</uncertaintyWeight>
    </logicTreeBranch>
  </logicTreeBranchSet>

    <!-- ===== BL4: SECONDARY-FD (conditioned on SECONDARY-SR by style) ===== -->
    <!-- Strike-Slip -->
  <logicTreeBranchSet branchSetID="bs4_ss_sfd_if_TAKAO2014"
                      uncertaintyType="fdhaSecondaryFDModel"
                      applyToBranches="SS_SSR_TAKAO2014 SS_SSR_PETERSEN2011"
                      applyToStyle="strike-slip">
    <logicTreeBranch branchID="SS_SFD_PETERSEN2011">
      <uncertaintyModel>Petersen2011SecondaryFD</uncertaintyModel>
      <uncertaintyWeight>1.0</uncertaintyWeight>
    </logicTreeBranch>
  </logicTreeBranchSet>

  </logicTree>
</nrml>