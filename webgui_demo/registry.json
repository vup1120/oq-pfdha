            {
              "name": "style",
              "type": "string",
              "units": "\u2013",
              "default": "\u2013",
              "allowed": "`\"normal\"`, `\"reverse\"`, `\"strike-slip\"` (case-insensitive)",
              "required": true,
              "description": "Fault style. Invalid values raise ValueError."
