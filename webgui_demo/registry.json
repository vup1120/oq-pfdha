              "type": "boolean",
              "units": "\u2013",
              "default": "`true`",
              "allowed": "`true`, `false`",
              "required": false,
              "description": "If true, averages probabilities from x/L and 1\u2212x/L positions. If false, uses only the site position."
            },
            {
              "name": "epistemic_uncertainty",
              "type": "boolean",
              "units": "\u2013",
              "default": "`true`",
              "allowed": "`true`, `false`",
              "required": false,
              "description": "If true, uses ensemble of coefficient realizations (posterior sampling). If false, uses mean coefficients only."
            },
            {
              "name": "coefficient_type",
              "type": "string",
              "units": "\u2013",
              "default": "\u2013",
              "allowed": "`\"full\"`, `\"mean\"`",
              "required": false,
              "description": "Alternative to `epistemic_uncertainty`. `\"full\"` enables epistemic uncertainty, `\"mean\"` uses mean coefficients. If provided, overrides `epistemic_uncertainty`."
            }
