        {
          "class_name": "Mammarella2024PrimarySR",
          "module": "openquake.fdha.primary_surf_rup.mammarella2024",
          "doc_page": "primary/MammarellaEtAl2024.md",
          "doc_params": [
            {
              "name": "MSR",
              "type": "int",
              "units": "\u2013",
              "default": "\u2013",
              "allowed": "`0`, `1`, `2`",
              "required": true,
              "description": "Magnitude scaling relation for the rupture-width distribution: `0` = Leonard (2014) interplate, `1` = Leonard (2014) stable continental region, `2` = Thingbaijam et al. (2017)."
            },
            {
              "name": "HDD_str",
              "type": "string",
              "units": "\u2013",
              "default": "\u2013",
              "allowed": "`ITA_N`, `GB_N`, `AGG_N`, `ITA_R`, `TAI_R`, `JAP_R`, `AGG_R`, `CA_S`, `NZ_S`, `JAP_S`, `AGG_S`",
              "required": true,
              "description": "Hypocentral depth distribution label (Table 2 of the paper); regional/style-specific mean and sigma of the hypocentral depth ratio."
            },
            {
              "name": "dip_sigma",
              "type": "float",
              "units": "degrees",
              "default": "\u2013",
              "allowed": "> 0",
              "required": true,
              "description": "Standard deviation of the fault dip distribution."
            },
            {
              "name": "t_d",
              "type": "float",
              "units": "\u03c3 units",
              "default": "\u2013",
              "allowed": "> 0",
              "required": true,
              "description": "Truncation of the dip distribution, in multiples of `dip_sigma`."
            },
            {
              "name": "Zs_sigma",
              "type": "float",
              "units": "km",
              "default": "\u2013",
              "allowed": "> 0",
              "required": true,
              "description": "Standard deviation of the seismogenic thickness distribution."
            },
            {
              "name": "t_z",
              "type": "float",
              "units": "\u03c3 units",
              "default": "\u2013",
              "allowed": "> 0",
              "required": true,
              "description": "Truncation of the seismogenic-thickness distribution, in multiples of `Zs_sigma`."
            },
            {
              "name": "style",
              "type": "string",
              "units": "\u2013",
              "default": "inferred from rake",
              "allowed": "`normal`, `reverse`, `strike-slip`",
              "required": false,
              "description": "Style of faulting; if omitted, it is inferred from the rupture rake."
            },
            {
              "name": "seismothickness",
              "type": "float",
              "units": "km",
              "default": "`15.0`",
              "allowed": "> 0",
              "required": false,
              "description": "Mean seismogenic thickness (used as `Zs_mu`). Set this explicitly if 15 km is not appropriate for your region."
